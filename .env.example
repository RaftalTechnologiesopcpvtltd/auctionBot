# ==============================================================================
# AuctionBot - Environment Configuration Template
# Copy this file to .env and configure values appropriate for your environment.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# Django Core Settings
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# PostgreSQL Database Configuration
POSTGRES_DB=auctionbot_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/0

# Celery Task Queue Configuration
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Static & Media Storage Configuration
STATIC_URL=/static/
MEDIA_URL=/media/
